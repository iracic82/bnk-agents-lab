#!/usr/bin/env bash
# The approved change reached Run:ai, and the controller raised BNK's limit by itself.
export KUBECONFIG=/etc/kubernetes/admin.conf
g=$(kubectl get projects.kai.resources tenant-b -o jsonpath='{.spec.queues[*].resources.gpu.deserved}' 2>/dev/null)
[ "$g" = 2 ] || { fail-message "tenant-b's Run:ai quota is ${g:-unknown}, not 2. Run labctl agents and type yes at the prompt."; exit 1; }
rl=$(labctl tenant show tenant-b --json 2>/dev/null | jq -r '.bnk.rateLimitRps')
[ "$rl" = 40 ] || { fail-message "Run:ai has 2 GPUs but BNK's limit is still ${rl}. Give the controller a few seconds and check again."; exit 1; }
exit 0
