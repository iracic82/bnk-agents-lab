#!/usr/bin/env bash
# The learner only reads; check that both MCP servers answer and nothing changed tenant-b.
export KUBECONFIG=/etc/kubernetes/admin.conf
n=$(labctl mcp bnk tools 2>/dev/null | grep -c read-only)
[ "$n" -ge 4 ] || { fail-message "bnk-tenancy-mcp didn't list its four read-only tools. Run: labctl mcp bnk tools"; exit 1; }
labctl mcp runai call manage_org_unit '{"action":"update","orgType":"project","name":"tenant-b","spec":{"quota":[{"nodePoolName":"default","gpuDeserved":2}]},"dryRun":true}' 2>/dev/null \
  | jq -e '.applied == false' >/dev/null || { fail-message "The Run:ai MCP dry run didn't answer. Run the dry-run command again."; exit 1; }
g=$(labctl tenant show tenant-b --json 2>/dev/null | jq -r '.runai.gpuDeserved')
[ "$g" = 0.5 ] || { fail-message "tenant-b's quota changed to $g. A call reached Run:ai with confirm=true; it should still be 0.5."; exit 1; }
exit 0
