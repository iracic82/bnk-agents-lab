#!/usr/bin/env bash
# After a decline nothing in Run:ai or BNK changes. The agent team must be installed and runnable.
export KUBECONFIG=/etc/kubernetes/admin.conf
[ -x /opt/bnk-agents/bin/nat ] || { fail-message "The agent team isn't installed (/opt/bnk-agents)."; exit 1; }
g=$(labctl tenant show tenant-b --json 2>/dev/null | jq -r '.runai.gpuDeserved')
[ "$g" = 0.5 ] || { fail-message "tenant-b's quota is $g. In this challenge you decline, so it should still be 0.5."; exit 1; }
rl=$(labctl tenant show tenant-b --json 2>/dev/null | jq -r '.bnk.rateLimitRps')
[ "$rl" = 10 ] || { fail-message "tenant-b's BNK limit is $rl, expected 10 req/s."; exit 1; }
exit 0
