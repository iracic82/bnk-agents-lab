# Single source of truth for pinned versions in the BNK 2.4 x open-source Run:ai lab.
# Every value here was used on a live sandbox.

# --- reused BNK cluster (real 3-VM kubeadm, proven on Instruqt) ---
BNK_KV_LAB_REPO=github.com/iracic82/bnk-ai-kv-lab.git
BNK_KV_LAB_REF=ff801fcfd246fe61a3d1c00aaa3c73905ef9c7d8
BNK_DEPLOY_REPO=github.com/iracic82/bnk-deploy.git
BNK_DEPLOY_REF=f587c1a6e2d271bef6dc2955a89149ed65d891e4
BNK_VERSION=2.4.0                       # from bnk-deploy versions.env
K8S_MINOR=1.30                          # from bnk-deploy versions.env

# --- open-source NVIDIA Run:ai (built from source, pushed to our GAR) ---
RUNAI_REPO=github.com/dsx-ai-factory/run-ai.git
RUNAI_REF=59e288d7
RUNAI_IMAGE_REGISTRY=docker.io/iracic82      # published by instruqt/runai-image-build
RUNAI_RESOURCE_MGMT_API=v0.1.5          # github.com/kai-scheduler/kai-resource-management-api (controller types)
RUNAI_RESOURCE_MGMT_REF=dc05a9d         # CRDs vendored in controller/test/crds
RUNAI_SCHEDULER_REF=a4c374e             # kai-scheduler/KAI-Scheduler, scheduling.run.ai Queue CRD

# --- simulated hardware ---
FAKE_GPU_OPERATOR_CHART=oci://ghcr.io/run-ai/fake-gpu-operator
FAKE_GPU_OPERATOR_VERSION=0.2.1               # pulled by local-dev.sh on 2026-10-15
MODEL_SIM_IMAGE=ghcr.io/iracic82/vllm-twin:0.2.0   # bnk-ai-kv-lab sims/vllm-twin; tag listed on ghcr.io 2026-10-15 (linux/amd64)

# --- observability ---
KUBE_PROMETHEUS_STACK_VERSION=91.9.0     # prometheus-community index 2026-10-15; appVersion v0.94.1, grafana subchart 13.2.7
PROMETHEUS_OPERATOR_VERSION=v0.94.1       # = kube-prometheus-stack appVersion; CRDs Run:ai's runai-operator needs (stripped-down-crds.yaml)

# --- MCP (both servers MCP 2026-07-28, stateless) ---
# NVIDIA's runai-mcp-server built from source at RUNAI_REF plus platform/mcp/stateless.patch, by
# platform/mcp/build-runai-mcp.sh. Index digest, linux/amd64. Verified 2026-10-19: protocol 2026-07-28,
# no session id, update refused without confirm=true, one PUT with it.
RUNAI_MCP_IMAGE=docker.io/iracic82/bnk-agents-runai-mcp:0.1.0@sha256:457868846fb6453b6a654835f66a0a20a6f557f4e3da1692271bc899c970787a
# bnk-tenancy-mcp with get_tenant_rejections (controller/cmd/mcp, `make mcp-push-hostgo`). Index digest, linux/amd64.
BNK_TENANCY_MCP_IMAGE=docker.io/iracic82/bnk-agents-tenancy-mcp:0.2.0@sha256:e4135479f5650854db108ae68d16ba042d7a36b73bad94232a028fcdc917765d
